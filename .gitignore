# ==========================================
# Fasal-Pramaan Webapp — .gitignore
# ==========================================

# ------------------------------------------
# Environment files & Secrets
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.envrc
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
private/
# Local agent/IDE session caches (do not publish)
.agents/
.codex/
.grok/
.commandcode/
apps/dashboard/AGENTS.md
apps/dashboard/CLAUDE.md

# ------------------------------------------
# Node / Next.js / Frontend
# ------------------------------------------
node_modules/
.next/
out/
.turbo/
.cache/
.vercel/
apps/dashboard/.vercel/
*.orig
.npm
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/

# ------------------------------------------
# Playwright E2E artifacts
# ------------------------------------------
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ------------------------------------------
# Python (scripts/test_supabase_conn.py only)
# ------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ------------------------------------------
# IDE & Text Editors
# ------------------------------------------
.idea/
.vscode/
*.suo
*.swp
*.swo
*~
*.bak

# ------------------------------------------
# System & OS Specific
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------
# Temp & Scratch Folders
# ------------------------------------------
tmp/
temp/
*.tmp
*.log
.scratch/
.scratch_*
reports/
artifacts/

# Fasal-Pramaan webapp environment (Vercel + local Next.js dev)
# Copy to apps/dashboard/.env.local for local dev, or set in Vercel project settings.
# Never commit real values. Server-only keys must never be NEXT_PUBLIC_*.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
# Use either PUBLISHABLE_KEY or ANON_KEY (both are supported)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for API writes. Never fall back to the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Site lock (leave empty locally; on Vercel a password locks the site)
SITE_LOCK_PASSWORD=

# Fasal Saathi voice + Gemini vision gate + field analysis
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_SESSION_MINUTES=15

# Vision model (gate + detailed analysis)
GEMINI_VISION_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=

# Rate limiting: on by default in production. ENABLE_RATE_LIMIT=true turns it
# on in local dev. DISABLE_RATE_LIMIT=true bypasses product routes only —
# login / signup / forgot / unlock stay throttled.
ENABLE_RATE_LIMIT=
DISABLE_RATE_LIMIT=

# External context signals (optional; stubs return "pending" without them)
SENTINEL_TOKEN=
IMD_API_KEY=
COPERNICUS_TOKEN=
OPENWEATHER_KEY=
# Bhuvan WMS override + key + layers (optional; defaults target public vec2 endpoint)
BHUVAN_WMS_URL=
BHUVAN_API_KEY=
# State-specific LULC layer from the Bhuvan thematic portal, e.g. lulc:BR_LULC50K_1112
BHUVAN_WMS_LAYERS=

# Comma-separated reviewer emails. Everyone else is a farmer.
REVIEWER_EMAILS=

# Canonical public origin for auth email redirects (required in production).
# Never trust Host / X-Forwarded-Host. Example: https://your-app.vercel.app
APP_ORIGIN=
NEXT_PUBLIC_SITE_URL=

# GitHub community badge (public repo "owner/name"; token raises rate limits)
NEXT_PUBLIC_GITHUB_REPO=dhrrishitvdeka/Fasal-Pramaan
GITHUB_TOKEN=

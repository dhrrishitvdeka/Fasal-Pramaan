# Fasal-Pramaan webapp environment (Vercel + local Next.js dev)
# Copy to apps/dashboard/.env.local for local dev, or set in Vercel project settings.
# Never commit real values. Server-only keys must never be NEXT_PUBLIC_*.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hugging Face inference Space
HF_TOKEN=
HF_SPACE_URL=https://dhrrishitvdeka-fasal-pramaan-api.hf.space

# Site lock (leave empty locally; on Vercel a password locks the site)
SITE_LOCK_PASSWORD=

# Fasal Saathi voice + Gemini vision gate
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_SESSION_MINUTES=15

# External context signals (optional; stubs return "pending" without them)
SENTINEL_TOKEN=
IMD_API_KEY=
COPERNICUS_TOKEN=
OPENWEATHER_KEY=

# Comma-separated reviewer emails. Everyone else is a farmer.
REVIEWER_EMAILS=

# Legacy REST API base (only for non-Supabase demo mode; empty = Supabase path).
# Baked into the client bundle at build time — set before `next build`.
NEXT_PUBLIC_API_BASE_URL=

# Vision gate / classifier model overrides (defaults: gemini-2.0-flash)
GEMINI_VISION_MODEL=
GOOGLE_API_KEY=

# Hugging Face model resolution (optional aliases; HF_SPACE_URL above is primary)
FASAL_HF_SPACE_URL=
HF_MODEL_ID=
HUGGINGFACE_API_TOKEN=
NEXT_PUBLIC_HF_SPACE_ID=

# GitHub community badge (public repo "owner/name"; token raises rate limits)
NEXT_PUBLIC_GITHUB_REPO=
GITHUB_TOKEN=

# Error telemetry (optional). Empty = local console + ring buffer only.
# When the Sentry SDK is added later, initTelemetry() will use this DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Fasal-Pramaan webapp environment (Vercel + local Next.js dev)
# Copy to apps/dashboard/.env.local for local dev, or set in Vercel project settings.
# Never commit real values. Server-only keys must never be NEXT_PUBLIC_*.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hugging Face inference Space
HF_TOKEN=
HF_SPACE_URL=https://dhrrishitvdeka-fasal-pramaan-api.hf.space

# Site lock (leave empty locally; on Vercel a password locks the site)
SITE_LOCK_PASSWORD=

# Fasal Saathi voice + Gemini vision gate
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_SESSION_MINUTES=15

# External context signals (optional; stubs return "pending" without them)
SENTINEL_TOKEN=
IMD_API_KEY=

# Comma-separated reviewer emails. Everyone else is a farmer.
REVIEWER_EMAILS=

# Error telemetry (optional). Empty = local console + ring buffer only.
# When the Sentry SDK is added later, initTelemetry() will use this DSN.
NEXT_PUBLIC_SENTRY_DSN=
